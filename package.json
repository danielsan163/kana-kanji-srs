{
  "name": "kana-kanji-srs",
  "version": "1.1.0",
  "description": "SRS study app for hiragana, katakana, kanji, vocabulary and phrases",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build-data": "node scripts/build-data.js && node scripts/build-examples.js",
    "test": "node test/grading.test.js && node test/sync.test.js",
    "dist": "electron-builder --win",
    "build-web": "node scripts/build-web.js",
    "serve-web": "node scripts/build-web.js && node scripts/serve-web.js"
  },
  "keywords": [
    "japanese",
    "kanji",
    "srs",
    "hiragana",
    "katakana",
    "electron",
    "jlpt"
  ],
  "author": "danielsan163",
  "license": "GPL-3.0-only",
  "type": "commonjs",
  "devDependencies": {
    "@fontsource/klee-one": "^5.3.1",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "kuromoji": "^0.1.2"
  },
  "productName": "Kana Kanji SRS",
  "build": {
    "appId": "local.kanakanjisrs.app",
    "productName": "Kana Kanji SRS",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "CHANGELOG.md",
      "app/**/*",
      "build/icon.png",
      "!scripts",
      "!raw",
      "!test"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Kana Kanji SRS",
      "runAfterFinish": true
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/danielsan163/kana-kanji-srs.git"
  }
}
